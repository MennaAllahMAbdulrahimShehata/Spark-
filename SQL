from pyspark.sql import SparkSession
spark = SparkSession.builder.master("local[*]").appName("people-lab").getOrCreate()
df = spark.read.json("people.json")
df.createOrReplaceTempView("people")
q1=spark.sql("SELECT AVG(age) FROM people WHERE age > 0").show()
q2=spark.sql("SELECT DISTINCT department FROM people;").show()
q3=spark.sql("SELECT DISTINCT id FROM people;").show()
q4=spark.sql("SELECT name FROM people WHERE name = 'Wilma Flintstone';").show()
q5=spark.sql("SELECT salary FROM people;").show()
q6=spark.sql("SELECT COUNT (name) AS adult_count FROM people WHERE age >= 18;").show()
q7=spark.sql("SELECT department, AVG(salary) AS avg_salary FROM people GROUP BY department ORDER BY avg_salary DESC LIMIT 1").show()
q9=spark.sql("SELECT COUNT(DISTINCT city) AS unique_cities FROM people;").show()
q10=spark.sql("SELECT department, COUNT(name) AS headcount FROM people GROUP BY department HAVING COUNT(name) > 2;").show()
q11=spark.sql("SELECT COUNT(age) FROM people WHERE age IS NULL;").show()
q13=spark.sql("SELECT * FROM people WHERE age < 0 OR age > 120;").show()
